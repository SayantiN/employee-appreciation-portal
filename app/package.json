{
  "name": "employee-appreciation-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Employee Appreciation Portal — SPEC.md v1.2, wireframe.html v2.1",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "seed:demo": "npm run seed:demo --workspace server",
    "seed:minimal": "npm run seed:minimal --workspace server",
    "reset": "npm run reset --workspace server",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
